# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=development          # development | production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gogo_dl
DB_SSLMODE=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: replace these with long, random secrets before deploying
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m            # access token lifetime
JWT_REFRESH_TTL=168h          # refresh token lifetime (7 days)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# WebSocket boundary
# Exact origins only; production must set this explicitly.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WS_ALLOW_MISSING_ORIGIN=true
WS_MAX_MESSAGE_BYTES=4096
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_USER=5

# HTTP boundary and in-process rate limits
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=16384
AUTH_RATE_PER_MINUTE=10
AUTH_RATE_BURST=5
WRITE_RATE_PER_MINUTE=120
WRITE_RATE_BURST=30
WS_RATE_PER_MINUTE=20
WS_RATE_BURST=5

# Observability (off until an operator configures private access / an exporter)
OTEL_SERVICE_NAME=gogo-dl
# Full OTLP HTTP traces URL, including /v1/traces; empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated name=value pairs; percent-encode commas in values.
# Store exporter credentials as secrets, never in this example.
OTEL_EXPORTER_OTLP_HEADERS=
TRACE_SAMPLE_RATIO=0.05
METRICS_ENABLED=false
METRICS_LISTEN_ADDR=127.0.0.1:9090
SHUTDOWN_TIMEOUT=15s

# Cloudflare R2 private attachment storage (all four values or none).
# No AWS account required. Scanner integration and R2 proofs are pending.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Enabling admission currently fails startup; keep false until scanner is integrated.
ATTACHMENT_UPLOAD_ENABLED=false
