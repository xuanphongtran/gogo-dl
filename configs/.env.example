# ── ConnectRPC Server ─────────────────────────────────────────────────────────
# Single port serves 3 protocols: gRPC (binary h2), gRPC-Web, Connect (JSON)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=development          # development | production

# ── Optional: Legacy Gin HTTP (dual-stack mode) ───────────────────────────────
# Uncomment & set a different port to run Gin alongside ConnectRPC.
# See docs/CONNECTRPC.md section "Dual-stack" for details.
# HTTP_SERVER_HOST=0.0.0.0
# HTTP_SERVER_PORT=8081

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gogo_dl
DB_SSLMODE=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: replace these with long, random secrets before deploying
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m            # access token lifetime
JWT_REFRESH_TTL=168h          # refresh token lifetime (7 days)

# ── CORS (for browser / gRPC-Web clients) ─────────────────────────────────────
# With ConnectRPC, wrap the http mux in rs/cors if you need browser origins.
# For the legacy Gin server, CORS is handled by gin-contrib/cors middleware.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
